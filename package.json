{
  "name": "mustafa-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Static portfolio site — Tailwind is compiled to a static CSS file, no other build step.",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/tailwind-src.css -o ./assets/css/tailwind.css --minify && node scripts/inline-home-css.js",
    "watch:css": "tailwindcss -i ./assets/css/tailwind-src.css -o ./assets/css/tailwind.css --watch",
    "refresh:blog": "node scripts/new-post.js --refresh",
    "refresh:blog-seo": "node scripts/refresh-blog-seo.js",
    "validate:blog-seo": "node scripts/validate-blog-seo.js",
    "validate:site-seo": "node scripts/validate-site-seo.js",
    "indexnow:submit": "node scripts/submit-indexnow.js",
    "test:indexnow": "node scripts/test-indexnow.js && node scripts/test-indexnow-plugin.js && node scripts/test-indexnow-submitter.js",
    "test:linkedin": "node scripts/test-linkedin-plugin.js",
    "test:proposal-roast": "node scripts/test-proposal-roast.js",
    "test:saas-metrics": "node scripts/test-saas-metrics-calculator.js",
    "test:ai-cost": "node scripts/test-ai-api-cost-calculator.js",
    "test:assistant": "node scripts/test-ask-mustafa-knowledge.js && node scripts/test-ask-mustafa-provider.js"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^3.4.17"
  }
}
